# Copy to .env. Local adapters must never be enabled on a public deployment.
APP_URL=http://localhost:3000
LOCAL_DEVELOPMENT=true
AUTH_MODE=local
DB_DRIVER=pglite
PGLITE_DIR=.local/database
# Set DB_DRIVER=postgres for a normal PostgreSQL server (required in production).
DATABASE_URL=postgresql://environment:environment@localhost:5432/environment
EVIDENCE_PROVIDER=local
EVIDENCE_DIR=.local/evidence
# Run jobs in the web process for local development; production uses npm run worker.
INLINE_WORKER=true
WORKER_USER_ID=es2
# Production: INLINE_WORKER=false, provision an active ES with approved Site grants.
# Production: AUTH_MODE=google, LOCAL_DEVELOPMENT=false, DB_DRIVER=postgres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Remote storage adapter contract is documented in README; fail closed until configured.
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_TOKEN=
