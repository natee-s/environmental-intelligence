{
  "name": "environmental-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "db:setup": "tsx scripts/database.ts setup",
    "worker": "tsx scripts/worker.ts",
    "provision": "tsx scripts/provision.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx scripts/postgres-check.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
